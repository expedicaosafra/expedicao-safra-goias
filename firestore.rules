rules_version = '2';
// Regras do Firestore da Expedição Safra Goiás.
// Cada pessoa precisa estar logada e ter um perfil em usuarios/{email} (criado por ela mesma como tec_prod, ou pelo administrador).
// Perfis: admin · rota (rota da expedição) · tec_prod (técnico de produtividade) · tec_cus (técnico de custos)
service cloud.firestore {
  match /databases/{database}/documents {
    function logado() { return request.auth != null && request.auth.token.email != null; }
    function email() { return request.auth.token.email.lower(); }
    // administradores master (contas fundadoras): únicos que gerenciam usuários
    function fundador() { return logado() && email() in ['expedicao.safra@ifag.org.br', 'vilmarjr.agronomia@gmail.com']; }
    function perfilPath() { return /databases/$(database)/documents/usuarios/$(email()); }
    function cadastrado() {
      return logado() && exists(perfilPath())
        && get(perfilPath()).data.get('ativo', true) != false
        && get(perfilPath()).data.get('_del', false) != true;
    }
    function papel() { return cadastrado() ? get(perfilPath()).data.papel : ''; }
    function admin() { return fundador() || papel() == 'admin'; }
    function algum() { return admin() || cadastrado(); }
    function produtividade() { return admin() || papel() in ['rota', 'tec_prod']; }
    function custos() { return admin() || papel() in ['rota', 'tec_cus']; }
    // visibilidade: a rota compartilha os dados entre si (rota:<nome da rota>); os demais veem só o que lançaram (u:<email>)
    function minha(v) {
      return cadastrado() && (
        (papel() == 'rota' && v == 'rota:' + get(perfilPath()).data.get('rota', ''))
        || (papel() != 'rota' && v == 'u:' + email()));
    }
    function ve(v) { return admin() || minha(v); }
    function criaComChave() { return admin() || minha(request.resource.data.vis); }
    function alteraMantendoChave() { return admin() || (minha(resource.data.vis) && request.resource.data.vis == resource.data.vis); }

    // cada pessoa pode criar o próprio acesso, sempre como técnico de produtividade;
    // ver a lista, mudar perfil, desativar ou remover é só com o administrador master (contas fundadoras)
    match /usuarios/{id} {
      allow read: if fundador() || (logado() && id == email());
      allow create: if fundador() || (logado() && id == email()
        && request.resource.data.papel == 'tec_prod'
        && request.resource.data.get('ativo', true) == true
        && !('_del' in request.resource.data));
      allow update, delete: if fundador();
    }
    match /config/{id} {
      allow read: if algum();
      allow write: if admin();
    }
    // fazendas importadas pelo administrador (vis = todos) aparecem para todos; as cadastradas em campo, só para quem cadastrou
    match /propriedades/{id} {
      allow read: if admin() || (cadastrado() && (resource.data.vis == 'todos' || minha(resource.data.vis)));
      allow create: if criaComChave();
      allow update: if alteraMantendoChave();
      allow delete: if admin();
    }
    // coleta de produtividade: cada um vê só o seu (ou o da sua rota)
    match /visitas/{id} { allow read: if ve(resource.data.vis); allow create: if produtividade() && criaComChave(); allow update: if produtividade() && alteraMantendoChave(); allow delete: if admin(); }
    match /amostragens/{id} { allow read: if ve(resource.data.vis); allow create: if produtividade() && criaComChave(); allow update: if produtividade() && alteraMantendoChave(); allow delete: if admin(); }
    match /pontos/{id} { allow read: if ve(resource.data.vis); allow create: if produtividade() && criaComChave(); allow update: if produtividade() && alteraMantendoChave(); allow delete: if admin(); }
    match /fotos/{id} { allow read: if ve(resource.data.vis); allow create: if produtividade() && criaComChave(); allow update: if produtividade() && alteraMantendoChave(); allow delete: if admin(); }
    match /fotosFull/{id} { allow read: if ve(resource.data.vis); allow create: if produtividade() && criaComChave(); allow update: if produtividade() && alteraMantendoChave(); allow delete: if admin(); }
    // custo de produção: só administrador, rota e técnicos de custo, cada um com os seus
    match /custos/{id} { allow read: if custos() && ve(resource.data.vis); allow create: if custos() && criaComChave(); allow update: if custos() && alteraMantendoChave(); allow delete: if admin(); }
  }
}
